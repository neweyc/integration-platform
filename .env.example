# Copy this file to .env and fill in your values before running Docker Compose.
# Never commit the .env file — it contains real secrets.

# Published image tag used by the Docker Compose files.
SERTO_IMAGE_TAG=1.5.0

# Common control-plane settings.
# Generate strong random values: openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-32-char-min-string
ENCRYPTION_MASTER_KEY=change-me-to-a-random-value
SERTO_JWT_ISSUER=integration-platform
SERTO_JWT_AUDIENCE=integration-platform
SERTO_JWT_EXPIRY_HOURS=24

# Failure alerts — platform-default email sender (ZeptoMail), optional.
# When set, tenants can send failure alerts by email without standing up their own SMTP server.
# Leave SERTO_ZEPTO_TOKEN blank to disable the email default; tenants can still bring their own SMTP.
SERTO_ZEPTO_TOKEN=
SERTO_ZEPTO_FROM_ADDRESS=alerts@example.com
SERTO_ZEPTO_FROM_NAME=Serto Alerts

# Production control-plane deployment.
# Use this with docker-compose.prod.yml when PostgreSQL runs separately.
SERTO_CONTROL_PLANE_CONNECTION_STRING=Host=db.example.com;Database=integration_platform;Username=platform;Password=change-me

# Single-host trial deployment.
# Used by docker-compose.trial.yml to run local PostgreSQL plus the control plane.
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me

# Agent deployment.
# Used by docker-compose.agent.yml on every host that should run integrations.
SERTO_AGENT_TOKEN=agt_change-me
SERTO_AGENT_ENVIRONMENT=production
SERTO_AGENT_CONTROL_PLANE_URL=https://control-plane.example.com
SERTO_AGENT_POLL_INTERVAL_SECONDS=30
SERTO_AGENT_PACKAGE_SYNC_INTERVAL_SECONDS=300
SERTO_AGENT_MAX_CONCURRENT_EXECUTIONS=5
SERTO_AGENT_SHUTDOWN_DRAIN_SECONDS=30
