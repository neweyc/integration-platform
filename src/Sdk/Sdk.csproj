<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Serto.Sdk</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Serto</Authors>
    <Description>SDK for building code-first integrations on Serto.</Description>
    <PackageProjectUrl>https://github.com/neweyc/integration-platform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neweyc/integration-platform</RepositoryUrl>
    <PackageTags>integration;automation;workflow;sdk</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
