<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sdk\Sdk.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Serto.Testing</PackageId>
    <Version>1.0.0</Version>
    <Authors>Serto</Authors>
    <Description>Testing helpers for Serto integrations — provides a test context and integration runner.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neweyc/integration-platform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neweyc/integration-platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>integration;automation;workflow;testing</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
