{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Database=integration_platform;Username=postgres;Password=postgres"
  },
  "Encryption": {
    "MasterKey": "CHANGE-THIS-TO-A-SECURE-RANDOM-VALUE"
  },
  "Jwt": {
    "Issuer": "integration-platform",
    "Audience": "integration-platform",
    "ExpiryHours": "24",
    "RefreshTokenExpiryDays": "30",
    "Secret": "CHANGE-THIS-TO-A-SECURE-SECRET-MIN-32-CHARS"
  },
  "Zepto": {
    "Token": "",
    "FromAddress": "",
    "FromName": "Serto Alerts",
    "BaseUrl": "https://api.zeptomail.com/v1.1/email"
  },
  "AlertWebhooks": {
    "AllowPrivateNetworkTargets": false
  },
  "RateLimit": {
    "Enabled": true,
    "PermitLimit": 300,
    "WindowSeconds": 60,
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "App": {
    "BaseUrl": ""
  }
}
