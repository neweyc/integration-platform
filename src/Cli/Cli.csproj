<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>serto</ToolCommandName>
    <PackageId>Serto.Cli</PackageId>
    <!-- Local/dev default only. Released versions are supplied by the publish pipeline via
         -p:Version (from the git tag), which overrides this. Do not hardcode a real version here. -->
    <Version>0.0.0-dev</Version>
    <Authors>Craytech</Authors>
    <Company>Craytech</Company>
    <Description>Command-line tools for scaffolding, testing, scanning, packaging, and deploying Serto integrations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/neweyc/integration-platform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/neweyc/integration-platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>integration;automation;workflow;cli;tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.13.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="Spectre.Console" Version="0.55.2" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Testing\Testing.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
